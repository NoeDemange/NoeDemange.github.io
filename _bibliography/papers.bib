  author = {Noé Demange and Yann Strozecki and Sandrine Vial},
  title = {Computational Generation of Substrate-Specific Molecular Cages},
  journal = {arXiv preprint arXiv:2604.11060},
  year = {2026},
  abstract = {In this paper, we propose a method to build molecular cages designed to capture a specific substrate. We model a cage as a graph of atoms with coordinates in space, and several constraints on their edges (degree, length and angle). We use a simple method to place binding patterns which are able to interact with certain parts of the substrate. We then propose an algorithm which considers all possible ways of connecting these binding patterns and try to construct the smallest possible molecular paths realizing these connections. We investigate many variants of our method in order to obtain the most efficient algorithm, able to build cages of more than a hundred atoms.},
